package {
    default_visibility: [":__subpackages__"],
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "auxiliary-java-defaults",
    lint: {
        strict_updatability_linting: true,
    },
    min_sdk_version: "Tiramisu",
}

filegroup {
    name: "auxiliary-sources",
    srcs: [
        "src/**/*.java",
    ],
    path: "src",
}

android_app {
    name: "Auxiliary",
    srcs: [
        ":auxiliary-sources",
        ":framework-auxiliary-aidl",
    ],
    libs: [
        "framework-auxiliary",
    ],
    sdk_version: "module_current",
    min_sdk_version: "Tiramisu",
    updatable: true,
    certificate: "platform", // TODO(b/215064213): sign with a auxiliary key
    apex_available: ["com.android.auxiliary"],
    defaults: [
        "auxiliary-java-defaults",
    ],
}
